# Arquivo de configuração do ambiente
# Renomeie para .env e preencha com seus dados reais
# NUNCA envie este arquivo com dados reais para o Git!

# Porta do servidor (deixe 5000)
PORT=5000

# String de conexão do MongoDB Atlas
# Crie uma conta em https://www.mongodb.com/cloud/atlas (grátis)
MONGODB_URI=mongodb+srv://seu_usuario:sua_senha@cluster.mongodb.net/organizador_de_leituras

# Chave secreta para gerar os tokens JWT
# Gere uma chave aleatória com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=coloque_aqui_uma_chave_secreta_longa

# Tempo de expiração do token (7d = 7 dias)
JWT_EXPIRES_IN=7d
